# Environnement de DÉVELOPPEMENT de l'API — copier en apps/api/.env
# (prisma et NestJS lisent ce fichier ; en production, les variables
# sont fournies par docker-compose.prod.yml)

# Base de données (le conteneur Docker du repo)
DATABASE_URL=postgresql://dts:dts_dev_password@localhost:5432/dts?schema=public

# Cache / présence
REDIS_URL=redis://localhost:6379

# Serveur
PORT=3000
CORS_ORIGINS=http://localhost:5000,http://localhost:8025

# Fichiers S3 (Garage local — provisionné automatiquement par le compose)
# Un seul bucket ; les types de fichiers sont des préfixes de clés :
# avatars/<id>.webp, attachments/<id>, media/<id>
S3_ENDPOINT=http://localhost:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=dtsdevkey
S3_SECRET_KEY=dts_dev_secret_change_me
S3_BUCKET=dts-files
S3_FORCE_PATH_STYLE=true

# Mails (MailPit en dev : boîte web http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@dts.local

# ── Réservé aux phases suivantes (P1/P3) — valeurs placeholder ──
JWT_SECRET=dev_only_change_me_000000000000000000000000
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_CHANGE_ME_000000000000000000
