# Variables Docker Compose — DÉVELOPPEMENT
# Copier ce fichier en .env puis adapter si besoin.

# PostgreSQL
POSTGRES_USER=dts
POSTGRES_PASSWORD=dts_dev_password
POSTGRES_DB=dts
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Garage (S3 local) — mêmes valeurs que apps/api/.env
S3_ACCESS_KEY=dtsdevkey
S3_SECRET_KEY=dts_dev_secret_change_me
S3_BUCKET=dts-files
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
