# Variables Docker Compose — PRODUCTION (mini-PC)
# Copier en .env et renseigner TOUTES les valeurs.

# ── Domaine (DuckDNS gratuit ou domaine acheté) ──
DOMAIN=monprojet.duckdns.org
ACME_EMAIL=admin@monprojet.duckdns.org

# ── PostgreSQL (générer : `openssl rand -hex 24`) ──
POSTGRES_USER=dts
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dts

# ── Garage (S3 — `openssl rand -hex 24` pour le secret) ──
S3_ACCESS_KEY=CHANGE_ME_S3_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=dts-files

# ── API (secrets applicatifs : `openssl rand -hex 32`) ──
JWT_SECRET=CHANGE_ME
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT
S3_PUBLIC_ENDPOINT=https://files.monprojet.duckdns.org

# ── Réseau / voix ──
# IP publique du mini-PC (requis par coturn et LiveKit)
PUBLIC_IP=1.2.3.4

# ── Envoi de mails (service transactionnel) ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@monprojet.duckdns.org
